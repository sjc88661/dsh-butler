{
  "name": "@dsh-external/dsh-butler",
  "version": "0.1.0",
  "description": "管家：个人助理内核（长期记忆 + 任务账本 + 证据守卫 + 资料版本 + 可加装能力包）",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "6.0.3",
    "tsdown": "0.22.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "typecheck": "node scripts/build.mjs --typecheck",
    "build:client": "node scripts/build.mjs --no-pack",
    "test": "node --test tests/*.test.mjs",
    "cost-probe": "node scripts/cost-probe.mjs"
  },
  "exports": {
    "./extension": {
      "types": "./lib/types/extension.d.ts",
      "default": "./lib/extension.js"
    },
    "./reminder-delivery": {
      "types": "./lib/types/reminder-delivery.d.ts",
      "default": "./lib/reminder-delivery.js"
    },
    "./channels": {
      "types": "./lib/types/channels.d.ts",
      "default": "./lib/channels.js"
    },
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
